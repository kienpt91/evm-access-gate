{
  "name": "evm-access-gate",
  "version": "0.1.0",
  "private": true,
  "description": "Educational example: an on-chain access registry (Solidity, OpenZeppelin) plus wallet-based login (EIP-4361 style) and an access check in TypeScript.",
  "license": "MIT",
  "author": "Kien Phan",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "HARDHAT_DISABLE_TELEMETRY=true hardhat build",
    "test": "HARDHAT_DISABLE_TELEMETRY=true hardhat test mocha",
    "test:gas": "HARDHAT_DISABLE_TELEMETRY=true hardhat test mocha --gas-stats",
    "coverage": "HARDHAT_DISABLE_TELEMETRY=true hardhat test mocha --coverage",
    "typecheck": "HARDHAT_DISABLE_TELEMETRY=true hardhat build && tsc -p tsconfig.json",
    "example": "HARDHAT_DISABLE_TELEMETRY=true hardhat run examples/flow.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.13",
    "@nomicfoundation/hardhat-mocha": "4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "3.0.12",
    "@nomicfoundation/hardhat-typechain": "3.1.3",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.5",
    "chai": "6.3.0",
    "hardhat": "3.21.0",
    "mocha": "12.0.3",
    "solc": "0.8.38",
    "typescript": "6.0.3"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
